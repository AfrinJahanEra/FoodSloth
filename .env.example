# FoodSloth - local secrets template
# Copy this file to `.env`, fill in real values, and NEVER commit `.env` (it is gitignored).
# How Spring Boot reads these: every secret in the yml files is a ${VAR_NAME:default}
# placeholder, and Spring resolves VAR_NAME from the OS environment. Two ways to load them:
#
#   1. IntelliJ: Run -> Edit Configurations -> <service> -> Environment variables ->
#      click the folder icon and select this .env file (2023.1+), or paste the lines.
#   2. Terminal (PowerShell):
#      Get-Content .env | ForEach-Object { if ($_ -match '^\s*([^#][^=]+)=(.*)$') {
#          Set-Item "env:$($matches[1].Trim())" $matches[2].Trim() } }
#
# payment-service also supports a local `payment-service/secrets.yml` file
# (see secrets.example.yml next to it) - use either mechanism, not both.

# --- payment-service (Stripe test-mode keys from https://dashboard.stripe.com/test/apikeys) ---
STRIPE_SECRET_KEY=sk_test_replace_with_your_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_webhook_secret
# Optional - override where Stripe redirects the browser after checkout:
#STRIPE_SUCCESS_URL=http://localhost:9005/payments/checkout-success?session_id={CHECKOUT_SESSION_ID}
#STRIPE_CANCEL_URL=http://localhost:9005/payments/checkout-cancel?session_id={CHECKOUT_SESSION_ID}

# --- api-gateway / user-service (JWT signing secret - keep both services on the same value) ---
# The default lives in their application.yml; override here for anything beyond local testing:
#JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
