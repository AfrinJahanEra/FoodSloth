@host = http://localhost:9001
@gateway = http://localhost:8080

### sign up (customer - default role)
POST {{host}}/users/signup
Content-Type: application/json

{
  "name": "Era Rahman",
  "email": "era@example.com",
  "phone": "01700000000",
  "password": "secret123"
}

### sign up (deliveryman)
POST {{host}}/users/signup
Content-Type: application/json

{
  "name": "Karim Delivery",
  "email": "karim.delivery@example.com",
  "phone": "01700000002",
  "password": "secret123",
  "role": "DELIVERYMAN",
  "vehicleType": "MOTORBIKE",
  "licenseNumber": "DL-123456"
}

### sign up (admin)
POST {{host}}/users/signup
Content-Type: application/json

{
  "name": "Rahim Owner",
  "email": "rahim.owner@example.com",
  "phone": "01700000003",
  "password": "secret123",
  "role": "ADMIN",
  "restaurantId": "restaurant-id-123"
}

### log in (works for any role - save the returned token to @token)
POST {{host}}/users/login
Content-Type: application/json

{
  "identifier": "era@example.com",
  "password": "secret123"
}

@token = PASTE_TOKEN_HERE
@adminToken = PASTE_ADMIN_TOKEN_HERE

### get my profile
GET {{host}}/users/me
Authorization: Bearer {{token}}

### update my profile
PUT {{host}}/users/me
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Era R.",
  "phone": "01700000001",
  "photo": "https://example.com/photo.jpg"
}

### list my addresses
GET {{host}}/users/me/addresses
Authorization: Bearer {{token}}

### add an address
POST {{host}}/users/me/addresses
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "label": "Home",
  "street": "12 Green Road",
  "city": "Dhaka",
  "area": "Dhanmondi"
}

### update an address (replace {addressId})
PUT {{host}}/users/me/addresses/{addressId}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "label": "Office",
  "street": "45 Gulshan Ave",
  "city": "Dhaka",
  "area": "Gulshan"
}

### set an address as default (replace {addressId})
PUT {{host}}/users/me/addresses/{addressId}/default
Authorization: Bearer {{token}}

### delete an address (replace {addressId})
DELETE {{host}}/users/me/addresses/{addressId}
Authorization: Bearer {{token}}

### update food preferences / dietary tags / default payment method reference
PUT {{host}}/users/me/preferences
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "foodPreferences": ["spicy", "vegetarian-friendly"],
  "dietaryTags": ["vegan", "no-nuts"],
  "defaultPaymentMethod": "payment-method-id-123"
}

### list all users (admin only, log in as the admin account above and paste its token into @adminToken)
GET {{host}}/users
Authorization: Bearer {{adminToken}}

### delete a user (admin only, replace {userId})
DELETE {{host}}/users/{userId}
Authorization: Bearer {{adminToken}}

### same signup call through the API Gateway
POST {{gateway}}/users/signup
Content-Type: application/json

{
  "name": "Gateway Test",
  "email": "gateway.test@example.com",
  "phone": "01800000000",
  "password": "secret123"
}
