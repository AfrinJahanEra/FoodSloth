{
  "info": {
    "name": "FoodSloth - Payment Service (Stripe demo)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:9005" },
    { "key": "sessionId", "value": "" },
    { "key": "paymentId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Create checkout session",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orderId\": \"order-123\",\n  \"userId\": \"user-456\",\n  \"amount\": 25000,\n  \"currency\": \"bdt\",\n  \"description\": \"FoodSloth test order\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/payments/checkout-session", "host": ["{{baseUrl}}"], "path": ["payments", "checkout-session"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "pm.collectionVariables.set('sessionId', body.sessionId);",
              "pm.collectionVariables.set('paymentId', body.paymentId);",
              "console.log('Open this URL in a browser to pay:', body.checkoutUrl);",
              "pm.test('status is 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Verify session (after paying in browser)",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/payments/session/{{sessionId}}/verify", "host": ["{{baseUrl}}"], "path": ["payments", "session", "{{sessionId}}", "verify"] }
      }
    },
    {
      "name": "3. Get payment by id",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/payments/{{paymentId}}", "host": ["{{baseUrl}}"], "path": ["payments", "{{paymentId}}"] }
      }
    },
    {
      "name": "4. Get payment by order",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/payments/order/order-123", "host": ["{{baseUrl}}"], "path": ["payments", "order", "order-123"] }
      }
    },
    {
      "name": "5. Get payments by user",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/payments/user/user-456", "host": ["{{baseUrl}}"], "path": ["payments", "user", "user-456"] }
      }
    },
    {
      "name": "6. Refund payment",
      "request": {
        "method": "POST",
        "url": { "raw": "{{baseUrl}}/payments/{{paymentId}}/refund", "host": ["{{baseUrl}}"], "path": ["payments", "{{paymentId}}", "refund"] }
      }
    }
  ]
}
